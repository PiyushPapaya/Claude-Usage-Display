// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored, so your credentials never get committed.

#define WIFI_SSID  "your-wifi"
#define WIFI_PASS  "your-password"

// LAN address of the machine running server.py — NOT localhost.
// The ESP is a separate device, so point it at the PC's IP.
#define SERVER_URL "http://192.168.1.42:8080/usage"

// ---- Optional hardware overrides --------------------------------------------
