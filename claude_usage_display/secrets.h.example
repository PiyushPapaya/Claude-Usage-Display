// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored, so your credentials never get committed.

#define WIFI_SSID  "your-wifi"
#define WIFI_PASS  "your-password"

// ---- Optional: captive-portal WiFi setup ------------------------------------
// Uncomment to configure WiFi from your phone/browser instead of hardcoding it
// above. On first boot the ESP hosts a "ClaudeUsage" hotspot; connect to it and
// pick your network. Requires the "WiFiManager" library (tzapu) in the IDE.
// With this on, WIFI_SSID/WIFI_PASS above are ignored (you can delete them).
// #define USE_WIFI_MANAGER

// LAN address of the machine running server.py — NOT localhost.
// The ESP is a separate device, so point it at the PC's IP.
#define SERVER_URL "http://192.168.1.42:8080/usage"

// ---- Optional hardware overrides --------------------------------------------
// Uncomment if your OLED is an SSD1306 instead of the default SH1106 (symptom:
// shifted text or noise on the display).
// #define OLED_SSD1306

// Uncomment to use different I2C pins than the SDA=D2, SCL=D1 default.
// #define OLED_SDA D2
// #define OLED_SCL D1

// Display brightness (0-255, default 160). Lower it for a dimmer always-on
// display; raise it toward 255 for maximum brightness.
// #define OLED_CONTRAST 160
