# Normalize line endings. Shell scripts must stay LF or they won't run on
# Linux/macOS; batch files must stay CRLF for cmd.exe.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.service text eol=lf
*.bat  text eol=crlf

# Binary assets — never touch.
*.png  binary
*.jpg  binary
*.bin  binary
*.elf  binary
*.hex  binary
